{
  // An assets-only Worker: public/ is served as it is, with no code in front of it.
  "name": "simplysosan-site",
  // No account_id: the CLOUDFLARE_API_TOKEN secret is scoped to exactly one account, and
  // wrangler uses that one. Pinning an id here made CI fail with "Authentication error
  // [code: 10000]" when the token was made on a different account of the same name.
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "./public/",
    "html_handling": "auto-trailing-slash"
  },
  // Previews only, for now. simplysosan.com still belongs to the GoHighLevel site, and
  // this is a proposal Sosan has not approved, so nothing here may claim a public address:
  // no routes and no workers.dev URL. Each pull request gets its own preview URL instead.
  // When she decides to switch, the custom domain goes in `routes` and a deploy workflow
  // is added, the same shape as capgaze-app.
  "workers_dev": false,
  "preview_urls": true
}
